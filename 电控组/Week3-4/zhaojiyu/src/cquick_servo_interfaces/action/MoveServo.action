# ===== Goal =====
# 字段摊平（不嵌套 ServoCommand），这样 ros2 action send_goal 能一行拼出来
uint8 id            # 目标舵机 ID
uint16 pwm          # 目标 PWM
uint16 duration_ms  # 用时 ms；0 表示使用参数 default_duration_ms
---
# ===== Result =====
bool success        # 是否成功到位
uint16 final_pwm    # 动作结束后 PRAD 读回的实际位置
string message      # 一句话原因：ok / 超限 / canceled / 串口错误 / 未到位(差 N)
---
# ===== Feedback =====
uint16 current_pwm  # 当前 PWM（按线性插值估算）
float32 progress    # 进度 0.0 ~ 1.0
