# MoveServo —— 控制一个或多个舵机的 Action 接口
#
# 两种模式，二选一：
#   单舵机：填 id + pwm
#   批量：  填 ids[] + pwms[]，驱动会拼成 {G0000#...!#...!} 一条指令发出去
# 批量模式是为了让多个舵机真正同时启动——分多条发会被控制板的总线缓冲挤掉。

# ---------- Goal ----------
uint8 id              # 单舵机模式用
uint16 pwm            # 单舵机模式用
uint16 duration_ms    # 两种模式都用；0 表示用默认值
uint8[] ids           # 批量模式：舵机 ID 列表
uint16[] pwms         # 批量模式：与 ids 一一对应的目标 PWM
---
# ---------- Result ----------
bool success
uint16 final_pwm      # 批量时填第一个舵机的读回值，详细结果看 message
string message        # ok / canceled / 未到位，目标X实际Y
---
# ---------- Feedback ----------
uint16 current_pwm    # 批量时取平均值
float32 progress      # 0.0 ~ 1.0
