# 第 3、4 周提交用 .gitignore
# 位置：电控组/Week3,4/youliangsiyuan/.gitignore
# 规则：能重新生成的东西一律不进仓库；数据和文档才进。
# 细则第九章原话：build/ install/ log/ 三个目录都必须进 .gitignore，谁交谁 PR 打回。

# ---------------------------------------------------------------
# colcon 的三个产物目录（最容易被误提交，也最容易让 PR 被打回）
# ---------------------------------------------------------------

# 编译中间产物。别人 clone 后自己 colcon build 就会重新生成，
# 而且体积大、路径里带绝对路径，交上去对别人没用，还会把 diff 撑爆。
build/

# 编译结果 + 安装后的 share 目录。ros2 run / ros2 launch 实际跑的是这里，
# 但它完全可以由源码重新 build 出来。交上来会让评审分不清哪个是源码。
install/

# 每个包的编译日志、测试日志。只对你本机这次编译有意义，评审不会看，
# 而且里面常带本机用户名、绝对路径。
log/

# ---------------------------------------------------------------
# Python 运行时垃圾
# ---------------------------------------------------------------

# Python 导入模块时自动生成的字节码缓存目录。
# 每台机器的 Python 版本可能不同，缓存不能通用，交上去纯属噪音。
__pycache__/

# 单独散落的 .pyc 字节码文件（有的环境不建目录、直接生成单个文件）。
*.pyc

# pytest 的缓存目录。任务 2 的加分项会写单测，跑一次 colcon test 就会生成；
# 里面是上次运行的缓存，交上去会让评审以为你改过测试。
.pytest_cache/

# ---------------------------------------------------------------
# 视频：一律不进仓库，录屏全部发 B 站，README 里贴链接
# ---------------------------------------------------------------

# 一个录屏几十 MB，几个人交上去仓库就变几个 G，以后谁 clone 都要等半天
# （细则第九章原话，前面同学已经踩过这个坑）。
*.mp4
*.avi
*.mkv

# ---------------------------------------------------------------
# bag：单个文件不进仓库，但 bag/run1/ 必须提交（细则 2.7 的交付物）
# ---------------------------------------------------------------

# 零散的 .bag 文件（例如随手录在 /tmp 或工作空间根目录的）不交，
# 因为 bag 是临时调试数据，交上去体积大又没法说明是哪次动作。
*.bag

# 例外：bag/run1/ 是**要交的数据**，评审要能 ros2 bag play 跑起来。
# 下面的否定规则把它整个保留下来（注意：否定规则必须写在忽略规则之后才生效）。
!bag/run1/
!bag/run1/**

# 提示：Humble 的 bag 是 metadata.yaml + *.db3，不是 ROS1 的 .bag，
# 所以上面那条 *.bag 不会误伤 run1/。改 bag 格式时先跑
#   git status --short
# 确认 bag/run1/ 里的文件是 "??" 或 "A"，而不是被忽略。

# ---------------------------------------------------------------
# 编辑器 / 系统杂项
# ---------------------------------------------------------------

# VS Code 的本地工作区设置，里面常带本机路径和调试配置，不该共享。
.vscode/

# 临时交换文件（nano/vim 崩溃时留下的），里面是半截文件内容。
*.swp
*.swo
*~

# macOS 的资源叉文件（如果你在 Mac 上碰过仓库）。
.DS_Store

# ---------------------------------------------------------------
# 一个提醒：这份 .gitignore 放在提交目录下，只对 `电控组/Week3,4/<姓名拼音>/` 生效。
# colcon 的 build/ install/ log/ 一般在工作空间根目录（比如 ~/ros2_ws），本来就不在仓库里；
# 但如果仓库根目录也会生成这三个目录，就把上面那三行同样加到仓库根目录的 .gitignore，
# 或者直接在提交前跑一次：
#   git ls-files | grep -E "^(build|install|log)/"
# 没有输出才算干净。
# ---------------------------------------------------------------
