<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cquick_servo</name>
  <version>0.1.0</version>
  <description>CQuick 舵机驱动包：Action Server/Client + launch + 参数</description>
  <maintainer email="dev@cquick.local">CQuick EControl</maintainer>
  <license>Apache-2.0</license>

  <!-- Python 节点运行时依赖 -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rclpy_action</exec_depend>
  <!-- 依赖本工程自建的接口包，编译顺序靠它保证 -->
  <exec_depend>cquick_servo_interfaces</exec_depend>
  <!-- launch 与 share 路径查找 -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- 串口库：sudo apt install python3-serial 提供 -->
  <exec_depend>python3-serial</exec_depend>

  <exec_depend>python3-yaml</exec_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
