# ===== Goal：一条完整指令 =====
uint8 id
uint16 pwm
uint16 duration_ms
---
# ===== Result：到底成没成 =====
bool success        # 是否成功
uint16 final_pwm    # 动作结束后 PRAD 读回的真实位置
string message      # 失败原因：超限/取消/串口错误/未到位
---
# ===== Feedback：执行中的进度 =====
uint16 current_pwm  # 当前 PWM
float32 progress    # 进度 0.0 ~ 1.0
