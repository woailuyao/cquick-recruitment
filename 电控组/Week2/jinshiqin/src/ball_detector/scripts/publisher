#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from ball_detector.msg import BallPos 

class BallPublisher(Node):
    def __init__(self):
        super().__init__('ball_publisher_node')
        self.publisher_ = self.create_publisher(BallPos, 'ball_pos', 10)
        
        self.balls = [
            (1, 1.0, 2.0), 
            (2, 3.0, 4.0), 
            (3, 5.0, 6.0)
        ]
        
        self.current_index = 0
        self.timer = self.create_timer(0.5, self.timer_callback)

    def timer_callback(self):
        msg = BallPos()
        ball_data = self.balls[self.current_index]
        
        msg.id = int(ball_data[0])
        msg.x = float(ball_data[1])
        msg.y = float(ball_data[2])
        
        self.publisher_.publish(msg)
        self.get_logger().info(f'发送球坐标 -> ID: {msg.id}, X: {msg.x}, Y: {msg.y}')
        
        self.current_index = (self.current_index + 1) % len(self.balls)

def main(args=None):
    rclpy.init(args=args)
    node = BallPublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
