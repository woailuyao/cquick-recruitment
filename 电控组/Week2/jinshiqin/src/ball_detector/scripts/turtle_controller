#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from turtlesim.msg import Pose
from ball_detector.msg import BallPos
import math

class TurtleController(Node):
    def __init__(self):
        super().__init__('turtle_controller_node')
        self.cmd_pub = self.create_publisher(Twist, '/turtle1/cmd_vel', 10)
        self.pose_sub = self.create_subscription(Pose, '/turtle1/pose', self.pose_callback, 10)
        self.ball_sub = self.create_subscription(BallPos, 'ball_pos', self.ball_callback, 10)
        
        self.current_pose = None 
        self.balls = {}           
        self.target_id = 1        
        self.is_moving = False    
        
        self.timer = self.create_timer(0.1, self.control_loop)
        self.get_logger().info('控制节点已启动，等待收齐 3 个球...')

    def ball_callback(self, msg):
        if msg.id not in self.balls:
            self.balls[msg.id] = (msg.x, msg.y)
            self.get_logger().info(f'收到球 {msg.id}: x={msg.x:.2f}, y={msg.y:.2f}')
            
        if len(self.balls) == 3 and not self.is_moving:
            self.is_moving = True
            self.get_logger().info('已收齐 3 个球，开始依次导航！')

    def pose_callback(self, msg):
        self.current_pose = msg

    def control_loop(self):
        if self.current_pose is None or not self.is_moving or self.target_id > 3:
            self.stop_turtle()
            return

        x_now = self.current_pose.x
        y_now = self.current_pose.y
        theta_now = self.current_pose.theta
        
        target_x, target_y = self.balls[self.target_id]

        distance = math.sqrt((target_x - x_now)**2 + (target_y - y_now)**2)
        target_angle = math.atan2(target_y - y_now, target_x - x_now)
        
        angle_diff = target_angle - theta_now
        while angle_diff > math.pi: angle_diff -= 2 * math.pi
        while angle_diff < -math.pi: angle_diff += 2 * math.pi

        if distance < 0.5:
            self.stop_turtle()
            self.get_logger().info(f'>>> 到达第 {self.target_id} 个球！实际坐标: ({x_now:.2f}, {y_now:.2f}), 误差: {distance:.2f}')
            self.target_id += 1  
            return

        cmd = Twist()
        if abs(angle_diff) > 0.1:
            cmd.linear.x = 0.0
            cmd.angular.z = 1.5 * angle_diff  
        else:
            cmd.linear.x = min(1.5, distance) 
            cmd.angular.z = 2.0 * angle_diff  
            
        self.cmd_pub.publish(cmd)

    def stop_turtle(self):
        cmd = Twist()
        cmd.linear.x = 0.0
        cmd.angular.z = 0.0
        self.cmd_pub.publish(cmd)

def main(args=None):
    rclpy.init(args=args)
    node = TurtleController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
