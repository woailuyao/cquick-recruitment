<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ball_tracker</name>
  <version>0.1.0</version>
  <description>CQuick 电控组第 2 周考核：自定义 BallPos 消息、发布/订阅 3 个球坐标、闭环导航依次到达</description>
  <maintainer email="ros2@example.com">zhangchengcheng</maintainer>
  <license>Apache-2.0</license>

  <!-- 编译工具：ament_cmake 是被选的构建类型，rosidl_default_generators 负责把 .msg 生成代码 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- 运行期依赖 -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_srvs</depend>
  <depend>turtlesim</depend>

  <!-- 消息运行时支持：没有它，import 消息类型会失败 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- 声明本包属于接口包分组（自定义消息必写，漏了编译报 rosidl 错） -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
