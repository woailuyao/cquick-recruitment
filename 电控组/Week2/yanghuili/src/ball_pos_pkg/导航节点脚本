#!/usr/bin/env python3
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from turtlesim.msg import Pose
from ball_pos_pkg.msg import BallPos
import math


class NavToBall(Node):
    def __init__(self):
        super().__init__('nav_to_ball')
        # 存3个球的坐标：{id: (x, y)}
        self.balls = {}
        # 乌龟当前位置
        self.turtle_x = 5.54
        self.turtle_y = 5.54
        self.turtle_theta = 0.0
        # 当前要去第几个球（1开始）
        self.target_index = 1
        # 三个目标点的顺序
        self.target_order = [1, 2, 3]
        # 是否收齐3个球
        self.got_all = False

        # 订阅球坐标
        self.sub_ball = self.create_subscription(
            BallPos, 'ball_pos', self.ball_callback, 10)
        # 订阅乌龟位置
        self.sub_pose = self.create_subscription(
            Pose, '/turtle1/pose', self.pose_callback, 10)
        # 发布速度
        self.pub_vel = self.create_publisher(Twist, '/turtle1/cmd_vel', 10)
        # 定时器，每0.1秒控制一次
        self.timer = self.create_timer(0.1, self.timer_callback)

        self.get_logger().info('导航节点已启动，等待球坐标...')

    def ball_callback(self, msg):
        self.balls[msg.id] = (msg.x, msg.y)
        if len(self.balls) == 3:
            if not self.got_all:
                self.got_all = True
                self.get_logger().info(f'收齐3个球: {self.balls}')

    def pose_callback(self, msg):
        self.turtle_x = msg.x
        self.turtle_y = msg.y
        self.turtle_theta = msg.theta

    def timer_callback(self):
        if not self.got_all:
            return  # 没收齐球，不动

        # 如果三个点都走完了，停住
        if self.target_index > 3:
            twist = Twist()
            self.pub_vel.publish(twist)
            return

        # 拿当前目标点
        target_id = self.target_order[self.target_index - 1]
        target_x, target_y = self.balls[target_id]

        # 算距离和方位角
        dx = target_x - self.turtle_x
        dy = target_y - self.turtle_y
        distance = math.sqrt(dx*dx + dy*dy)
        target_theta = math.atan2(dy, dx)

        # 角度差：目标方位角 - 当前朝向，归一化到[-pi, pi]
        angle_diff = target_theta - self.turtle_theta
        while angle_diff > math.pi:
            angle_diff -= 2 * math.pi
        while angle_diff < -math.pi:
            angle_diff += 2 * math.pi

        twist = Twist()

        # 如果已经到了（距离<0.5）
        if distance < 0.5:
            self.get_logger().info(
                f'到达球{self.target_index}，实际坐标({self.turtle_x:.2f}, {self.turtle_y:.2f})，误差{distance:.2f}')
            self.target_index += 1
            return

        # 方位角差大 → 原地转，不走
        if abs(angle_diff) > 0.1:
            twist.linear.x = 0.0
            twist.angular.z = 1.5 if angle_diff > 0 else -1.5
        else:
            # 方位角对上了 → 边走边微调，越接近目标速度越小
            twist.linear.x = min(1.0, distance * 0.5)
            twist.angular.z = 3.0 * angle_diff

        self.pub_vel.publish(twist)


def main():
    rclpy.init()
    node = NavToBall()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()


if __name__ == '__main__':
    main()
