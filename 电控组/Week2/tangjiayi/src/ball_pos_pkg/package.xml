<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ball_pos_pkg</name>
  <version>0.0.1</version>
  <description>第 2 周任务 1：自定义 BallPos 消息 + 发布/订阅 3 个球的坐标</description>

  <maintainer email="you@example.com">tangjiayi</maintainer>
  <license>Apache-2.0</license>

  <!-- ① 构建工具：ament_cmake（自定义消息必须走 CMake 编译流程） -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- ② 消息生成工具：把 .msg 编成 C++/Python 类型 -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- ③ 消息运行时依赖：编译期需要，运行期也需要 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ④ Python 节点用到的库 -->
  <depend>rclpy</depend>

  <!-- ⑤ 声明本包属于「接口包分组」，漏了它编译会报一堆 rosidl 错误 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
