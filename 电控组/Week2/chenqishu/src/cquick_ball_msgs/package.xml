<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cquick_ball_msgs</name>
  <version>0.0.1</version>
  <description>第2周任务1：自定义 BallPos 消息 + 3 个球的发布者/订阅者</description>
  <maintainer email="chenqishu@todo.todo">chenqishu</maintainer>
  <license>Apache-2.0</license>

  <!-- 自定义消息必须走 CMake 编译流程，所以 build_type 是 ament_cmake，不是 ament_python -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ① 消息生成工具：把 .msg 编译成 C++/Python 的消息类型 -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- ② rclpy：scripts/ 下的 Python 节点要用 -->
  <depend>rclpy</depend>

  <!-- ③ 消息运行时依赖：运行时真正 import 消息类型靠它 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- ④ 声明本包属于「接口包分组」，漏了它 colcon build 会报一堆 rosidl 错误 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
