<?xml version="1.0"?>
<package format="3">
  <name>target_position_msgs</name>
  <version>0.0.1</version>
  <description>自定义消息：目标位置（CQuick 视觉组第二周考核）</description>
  <maintainer email="weikai@example.com">weikai</maintainer>
  <license>MIT</license>

  <!-- 接口包必须是 ament_cmake，并声明 rosidl 生成器 -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- 运行时依赖 rosidl 运行时 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- 标记为本机是「接口包」，colcon 会先编译它再编译依赖它的包 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
