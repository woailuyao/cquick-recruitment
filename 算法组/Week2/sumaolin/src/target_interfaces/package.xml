<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>target_interfaces</name>
  <version>0.0.0</version>
  <description>自定义消息 TargetPosition：目标中心像素坐标与轮廓面积</description>
  <maintainer email="sumaolin@example.com">sumaolin</maintainer>
  <license>Apache-2.0</license>

  <!-- 消息包靠 CMake 里的 rosidl_generate_interfaces() 生成代码，所以必须是 ament_cmake -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- 生成出来的 Python/C++ 代码运行时要靠这个包 -->
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- 没这行，rosidl 不会把本包识别成"接口包"，编译时找不到生成目标 -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
