# =============================================================================
# TargetPosition.msg —— 任务1（足球检测）主输出
#
# 字段名严格对齐考核细则 1.7 节"实时检测与输出"要求：
#   类别名称 / 置信度 / 检测框 x1,y1,x2,y2 / 中心像素 center_u,center_v /
#   帧号或时间戳 / 实时 FPS
#
# 注意：本任务只输出**像素位置**，不做单目测距；
#      检测框中心 ≠ 足球三维球心（球是球体，框中心只是投影近似）。
# =============================================================================

bool detected            # 本帧是否检测到足球

string class_name        # 固定为 "ball"（保留字段名，方便以后扩展）
float32 confidence       # 置信度 0~1

float32 x1               # 检测框左上角 x（像素）
float32 y1               # 检测框左上角 y（像素）
float32 x2               # 检测框右下角 x（像素）
float32 y2               # 检测框右下角 y（像素）

float32 center_u         # 检测框中心 u = (x1+x2)/2
float32 center_v         # 检测框中心 v = (y1+y2)/2
float32 area             # 检测框面积（像素²），用于判断远近/大小

uint32 frame_id          # 帧号（从 1 开始递增）
float32 fps              # 实时处理帧率
string stamp             # 采集时间 "YYYY-MM-DD HH:MM:SS"
