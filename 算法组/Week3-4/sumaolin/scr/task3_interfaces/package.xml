  <version>0.0.0</version>
  <description>Task3 定位结果的消息：相机位姿、场地标志与足球检测</description>
  <maintainer email="sumaolin@example.com">sumaolin</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
